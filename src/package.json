{
  "name": "dsh-client",
  "version": "1.0.0",
  "description": "DSH desktop client (built-in UI, no browser)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-packager . \"DSH客户端\" --platform=win32 --arch=x64 --out=dist --overwrite --asar",
    "dist": "electron-builder --win nsis"
  },
  "author": "dante",
  "license": "MIT",
  "build": {
    "appId": "com.dante.dsh-client",
    "productName": "DSH客户端",
    "files": [
      "main.js",
      "loading.html",
      "settings.html",
      "setup.html",
      "statusbar.html",
      "preload.js",
      "status-preload.js",
      "icon.png",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "install-dsh-v1.0.0.exe",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "DSH客户端"
    }
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.0.0",
    "electron-packager": "^17.1.2"
  }
}